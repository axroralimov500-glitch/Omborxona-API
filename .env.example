# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (SQLite file path)
DB_PATH=./data/ecommerce.db

# Authentication / Security
JWT_SECRET=super-secret-jwt-key-2026-production-ready
TOKEN_EXPIRY_HOURS=24

# Payment Provider Mock Webhook Configuration
PAYMENT_WEBHOOK_SECRET=mock-pay-secret-key-xyz-12345

# Order Reservation TTL in Minutes (default: 15 minutes)
ORDER_RESERVATION_TTL_MINUTES=15

# Automatic Expiry Cleaner Interval in Seconds
CLEANUP_INTERVAL_SECONDS=30
